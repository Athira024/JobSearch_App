@model JobSearch_App.Models.JobSeekerRegCls
@{
    ViewBag.Title = "JSReg_Pageload";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>JobSeeker Registration</h2>
<div>
    @using (Html.BeginForm("JSReg_Click", "JobSeekerRegDB", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        <div>
            <label>Name:</label>
        </div>
        <div>
            @Html.TextBoxFor(m => m.JS_Name)
            @Html.ValidationMessageFor(m => m.JS_Name)
        </div>
        <br />
        <div>
            <label>Age:</label>
        </div>
        <div>
            @Html.TextBoxFor(m => m.JS_Age)
            @Html.ValidationMessageFor(m => m.JS_Age)
        </div>
        <br />
        <div>
            <label>Phone:</label>
        </div>
        <div>
            @Html.TextBoxFor(m => m.JS_Phone)
            @Html.ValidationMessageFor(m => m.JS_Phone)
        </div>
        <br />
        <div>
            <label>Email:</label>
        </div>
        <div>
            @Html.TextBoxFor(m => m.JS_Email)
            @Html.ValidationMessageFor(m => m.JS_Email)
        </div>
        <br />
        <div>
            <label>Address:</label>
        </div>
        <div>
            @Html.TextAreaFor(m => m.JS_Address)
            @Html.ValidationMessageFor(m => m.JS_Address)
        </div>
        <br />
        <div>
            <label>Qualification:</label>
        </div>
        <div>
            @foreach (var item in Model.MyQual)
            {
                <label>
                    <input type="checkbox" value="@item.Value" checked="@item.IsChecked" name="selectedQual" id="@item.Value" />@Html.Raw(@item.Text)
                </label>
            }
        </div>
        <br />
        <div>
            <label>Experience:</label>
        </div>
        <div>
            @Html.TextBoxFor(m => m.JS_Experience)
        </div>
        <br />
        <div>
            <label>Skills:</label>
        </div>
        <div>
            @Html.TextAreaFor(m => m.JS_Skills)
        </div>
        <br />
        <div>
            <label>Photo:</label>
        </div>
        <div>
            @Html.TextBox("file", "", new { Type = "file" })
        </div>
        <br />
        <div>
            <label>Username:</label>
        </div>
        <div>
            @Html.TextBoxFor(m => m.Username)
        </div>
        <br />
        <div>
            <label>Password:</label>
        </div>
        <div>
            @Html.PasswordFor(m => m.Pwd)
        </div>
        <br />
        <div>
            <label>Confirm Password:</label>
        </div>
        <div>
            @Html.PasswordFor(m => m.Cpwd)
            @Html.ValidationMessageFor(m => m.Cpwd)
        </div>
        <br />
        <div>
            <input type="submit" value="Insert" />
            @Html.DisplayFor(m => m.JSmsg)
        </div>
    }
</div>

